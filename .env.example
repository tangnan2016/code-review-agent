# ============================================================
#  .env.example - 环境变量配置模板
#  cp .env.example .env  然后填入真实值
#  .env 已加入 .gitignore，不会提交到代码仓库
# ============================================================

# LLM API 密钥（config.yaml 中用 ${VAR_NAME} 引用）
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Docker 挂载：宿主机代码目录 → 容器内 /workspace
# MCP 工具调用时传入 /workspace/your-project 即可访问宿主机代码
REVIEW_SOURCE_DIR=/Users/your-name/Projects